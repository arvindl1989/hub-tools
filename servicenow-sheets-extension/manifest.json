{
  "manifest_version": 3,
  "name": "ServiceNow \u2192 Digital Marketing Hub",
  "version": "1.0.0",
  "description": "One-click pull of a ServiceNow list view into the Digital Marketing Hub",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.service-now.com/*",
    "https://hub-tools-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.service-now.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync ServiceNow \u2192 Hub"
  },
  "externally_connectable": {
    "matches": [
      "https://hub-tools-production.up.railway.app/*",
      "https://*.up.railway.app/*",
      "https://*.railway.app/*",
      "http://localhost/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
